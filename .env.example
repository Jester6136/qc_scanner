# Chép file này thành `.env` rồi điền key thật. `.env` đã bị .gitignore chặn.
#
# Sinh key (chạy ở đâu cũng được, key chỉ là chuỗi ngẫu nhiên):
#     echo "qcs-$(openssl rand -hex 32)"
#
# Mỗi client một key, ngăn cách bằng dấu phẩy. Phần trước dấu ':' là tên bạn tự
# đặt để biết key của ai — client không cần biết tới nó.
QC_SCANNER_API_KEYS="app-web:qcs-THAY-BANG-KEY-THAT"

# Cổng mở ra LAN (mặc định 5000). macOS bị AirPlay chiếm 5000 thì đổi số khác.
#QC_SCANNER_PORT=5000
