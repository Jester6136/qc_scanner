# general things to ignore
build/
dist/
*.egg-info/
*.egg
*.py[cod]
__pycache__/
*.so
*~

# due to using tox and pytest
.tox
.cache
# ẢNH ĐẦU VÀO THẬT — giấy tờ tuỳ thân của khách, tuyệt đối không commit.
#
# Glob, không liệt kê tay. Chỗ này từng ghi `tmp/` + `tmp_2/`, rồi `tmp_3/` xuất hiện
# và nằm ngoài hàng rào — `git add -A` là ảnh CCCD/sổ đỏ vào lịch sử git vĩnh viễn,
# nơi xoá đi cũng không thật sự mất. Hàng rào tương ứng ở `.dockerignore` (và
# `Dockerfile.test.dockerignore`) đã dính đúng lỗi này cùng lúc.
#
# Hai dòng rời thay cho `tmp[-_]*` để giống hệt `.dockerignore` — bên đó bắt buộc
# phải tách vì Docker báo lỗi cú pháp với `[-_]`. Hai hàng rào viết cùng một kiểu
# thì sửa một chỗ là nhớ sửa chỗ kia.
tmp
tmp_*
tmp-*

# API key và mọi bí mật khác. `docker compose` đọc `.env` ở thư mục dự án để nội
# suy biến, nên đây là chỗ tự nhiên để đặt QC_SCANNER_API_KEYS trên máy server —
# và cũng vì thế nó là chỗ tự nhiên để vô tình commit một mật khẩu.
.env
.env.*
!.env.example
