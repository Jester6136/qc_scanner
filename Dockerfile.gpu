# Bản GPU NVIDIA (SPD-4).
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build -d
#
# ⚠️ CHƯA CHẠY THỬ LẦN NÀO. Máy phát triển là macOS, không có CUDA. File này viết
# theo tài liệu onnxruntime; lần đầu chạy trên máy server phải kiểm bằng
#     curl -s http://localhost:5000/healthz
# và nhìn `providers`. Thấy `CUDAExecutionProvider` thì GPU đang chạy thật; chỉ thấy
# `CPUExecutionProvider` nghĩa là nó đã lặng lẽ tụt về CPU — build sai, không phải chạy chậm.
#
# Yêu cầu phía host: driver NVIDIA + NVIDIA Container Toolkit.
# Kiểm trước khi build:  docker run --rm --gpus all nvidia/cuda:12.4.1-base-ubuntu22.04 nvidia-smi

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS base

# Ghim cặp CUDA 12.4 + cuDNN 9 vì onnxruntime-gpu 1.19+ dựng trên đúng cặp đó.
# Lệch phiên bản là kiểu hỏng tệ nhất ở đây: không lỗi, chỉ âm thầm chạy CPU.

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Venv chứ không cài thẳng vào python hệ thống. Hai lý do, đều là lỗi thật:
#
# * pip của Ubuntu 22.04 là bản 22.x, **không có** cờ `--break-system-packages`
#   (thêm từ pip 23.0.1) — dùng cờ đó ở đây là build đứt ngay.
# * Base image sau này nâng lên 24.04 thì python hệ thống có dấu PEP 668
#   (externally-managed) và `pip install` bị chặn. Venv miễn nhiễm cả hai.
#
# Đặt venv lên đầu PATH thì `qc-scanner-server`, `qc-scanner-bench` và `python3`
# đều trỏ đúng vào đó, kể cả trong healthcheck và `docker exec`.
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

COPY requirements-gpu.txt ./
RUN pip install --no-cache-dir -r requirements-gpu.txt

# Chốt chặn lúc BUILD cho lỗi đóng gói hay gặp nhất: cài nhầm `onnxruntime` (bản CPU)
# bên cạnh `onnxruntime-gpu`. Hai gói ghi đè lên nhau nên `import onnxruntime` lấy bản
# nào là ngẫu nhiên — và bản CPU thì chạy đúng, chỉ chậm gấp mấy chục lần, không lỗi
# nào để lần ra. Thà đứt build ở đây còn hơn phát hiện sau khi đã lên production.
#
# Đây thuần tuý là kiểm metadata gói, không đụng gì tới GPU (lúc build thường không có
# GPU). Việc CUDA có chạy thật hay không thì `/healthz` mới trả lời được.
RUN pip list --format=freeze | grep -q '^onnxruntime-gpu=' \
 && ! pip list --format=freeze | grep -q '^onnxruntime=' \
 || (echo "LỖI: phải có onnxruntime-gpu và KHÔNG được có onnxruntime (bản CPU)." \
     && pip list | grep -i onnxruntime && exit 1)

COPY . .
RUN pip install --no-cache-dir .

# Nướng model vào image — bước này cần mạng lúc BUILD, không cần lúc chạy.
ENV U2NET_HOME=/opt/u2net
RUN python -c "from qc_scanner.rembg_session import warmup; warmup()"

EXPOSE 5000
ENV QC_SCANNER_WORK_HEIGHT=500
ENV QC_SCANNER_ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# Trên GPU, phần suy luận không còn là nút cổ chai — phần CPU (giải mã ảnh, mã hoá
# PNG) mới là. Nới đồng thời để việc CPU của request này chồng lên GPU của request
# kia. Con số 4 là ước đoán, chưa đo; chỉnh lại sau khi đo trên máy thật.
ENV QC_SCANNER_MAX_CONCURRENCY=4

CMD ["qc-scanner-server", "-a", "0.0.0.0", "-p", "5000"]
